+		deadline := time.Now().Add(5 * time.Second)
+		for {
+			if err := bus.Publish(ctx, TopicLive, cache.Message{Type: typ, Data: data}); err != nil {
+				t.Fatalf("Publish: %v", err)
+			}
+			select {
+			case env := <-c.send:
+				return env
+			case <-time.After(20 * time.Millisecond):
+				if time.Now().After(deadline) {
