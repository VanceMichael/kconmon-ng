+func decodeImportBody(t *testing.T, w *httptest.ResponseRecorder) importResponse {
+	t.Helper()
+	var out importResponse
+	if err := json.Unmarshal(w.Body.Bytes(), &out); err != nil {
+		t.Fatalf("decode import body: %v (%s)", err, w.Body)
+	}
+	return out
+}
